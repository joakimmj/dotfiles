@import "redox.rasi"
window {
    location:                    center;
    anchor:                      center;
    width:                       600px;
    border:                      2px solid;
    border-radius:               12px;
    border-color:                @border-colour;
}
mainbox {
    orientation:                 vertical;
    children:                    [ "inputbar", "listview", "mode-switcher" ];
    spacing:                     10px;
    padding:                     15px;
}
inputbar {
    spacing:                     10px;
    background-color:            transparent;
    children:                    [ "prompt", "entry" ];
}
entry {
    expand:                      true;
    width:                       0px;
    horizontal-align:            0.0;
}
listview {
    layout:                      vertical;
    lines:                       8;
    columns:                     1;
    fixed-height:                true;
    spacing:                     4px;
}
element {
    padding:                     6px 12px;
    border-radius:               8px;
}
mode-switcher {
    spacing:                     8px;
}
button {
    padding:                     6px;
    border-radius:               100%;
}
